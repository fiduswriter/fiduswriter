// Fidus Writer will combine this file with package.json files in other installed
// apps before executing npm commands. Different from a regular package.json, comments
// are allowed in this file.

{
    name: "fidus-writer",
    description: "Install dependencies for ES6 transpilation",
    scripts: {
        copy_fwtoolkit_css: "mkdir -p ../static-libs/css/fwtoolkit/ && rsync -av --no-perms --checksum node_modules/fwtoolkit/css/ ../static-libs/css/fwtoolkit/",
        copy_frontend_css: "mkdir -p ../static-libs/css/ && rsync -av --no-perms --checksum node_modules/@fiduswriter/frontend/css/ ../static-libs/css/",
        copy_editor_css: "mkdir -p ../static-libs/css/editor/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/editor/css/ ../static-libs/css/editor/ 2>/dev/null || echo 'Editor CSS not found, skipping.')",
        copy_bibliography_css: "mkdir -p ../static-libs/css/bibliography/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/bibliography-manager/css/ ../static-libs/css/bibliography/ 2>/dev/null || echo 'Bibliography CSS not found, skipping.')",
        copy_image_manager_css: "mkdir -p ../static-libs/css/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/image-manager/css/ ../static-libs/css/ 2>/dev/null || echo 'Image manager CSS not found, skipping.')",
        copy_document_template_editor_css: "mkdir -p ../static-libs/css/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/document-template-editor/css/ ../static-libs/css/ 2>/dev/null || echo 'Document template editor CSS not found, skipping.')",
        copy_frontend_static: "mkdir -p ../static-libs/ && rsync -av --no-perms --checksum node_modules/@fiduswriter/frontend/static/ ../static-libs/",
        copy_editor_static: "mkdir -p ../static-libs/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/editor/static/ ../static-libs/ 2>/dev/null || echo 'Editor static assets not found, skipping.')",
        copy_fontawesome: "mkdir -p ../static-libs/css/fontawesome/css/ && rsync -av --no-perms --checksum node_modules/@fortawesome/fontawesome-free/css/ ../static-libs/css/fontawesome/css/ && rsync -av --no-perms --checksum node_modules/@fortawesome/fontawesome-free/webfonts/ ../static-libs/css/fontawesome/webfonts/",
        copy_prosemirror_css: "mkdir -p ../static-libs/css/ && rsync -av --no-perms --checksum node_modules/prosemirror-view/style/prosemirror.css ../static-libs/css/ && rsync -av --no-perms --checksum node_modules/prosemirror-menu/style/menu.css ../static-libs/css/prosemirror-menu.css && rsync -av --no-perms --checksum node_modules/prosemirror-example-setup/style/style.css ../static-libs/css/prosemirror-example-setup.css",
        copy_mathlive: "mkdir -p ../static-libs/css/libs/ ../static-libs/zip/ && (rsync -av --no-perms --checksum node_modules/@fiduswriter/document/static-libs/css/libs/mathlive/ ../static-libs/css/libs/mathlive/ 2>/dev/null || echo 'MathLive CSS not found (transitive dep not hoisted), skipping.') && (rsync -av --no-perms --checksum node_modules/@fiduswriter/document/static-libs/zip/mathlive_style.zip ../static-libs/zip/mathlive_style.zip 2>/dev/null || echo 'MathLive zip not found, skipping.')",
        copy_schema: "mkdir -p ../static-libs/json && (test -f node_modules/@fiduswriter/document/schema.json && cp node_modules/@fiduswriter/document/schema.json ../static-libs/json/schema.json) || (node node_modules/@fiduswriter/document/scripts/export-schema.js 2>/dev/null && cp node_modules/@fiduswriter/document/schema.json ../static-libs/json/schema.json) || echo 'Schema not found (transitive dep not hoisted), skipping.'",
        // Aggregate per-package locale JSON files into static-libs/json/ so the
        // /api/jsi18n/ view can read them at runtime.  Scans all @fiduswriter/*
        // packages and fwtoolkit dynamically — no hardcoded package list needed.
        // Each package's locale/<lang>/messages.json is copied to
        // static-libs/json/<pkg-name>/locale/<lang>/messages.json.
        // Fix url("../static/...") references in CSS files that were written
        // for the npm package layout.  The postinstall scripts copy fonts/images
        // from <pkg>/static/ into static-libs/ (stripping the "static/" prefix),
        // so url("../static/fonts/...") must become url("../fonts/...") for
        // top-level CSS files and url("../../img/...") for files one level deep.
        fix_css_urls: "find ../static-libs/css -maxdepth 1 -name '*.css' -exec sed -i 's|url(\"../static/|url(\"../|g' {} \\; 2>/dev/null; find ../static-libs/css -mindepth 2 -maxdepth 2 -name '*.css' -exec sed -i 's|url(\"../static/|url(\"../../|g' {} \\; 2>/dev/null; echo '  fixed CSS url() paths' || true",
        copy_locale_json: "mkdir -p ../static-libs/json/ && for pkg_dir in node_modules/fwtoolkit node_modules/@fiduswriter/*/; do [ -d \"$pkg_dir\" ] || continue; pkg_name=$(basename \"$pkg_dir\"); if [ -d \"$pkg_dir/locale\" ]; then mkdir -p \"../static-libs/json/$pkg_name/\" && rsync -av --no-perms --checksum \"$pkg_dir/locale/\" \"../static-libs/json/$pkg_name/locale/\" 2>/dev/null && echo \"  copied locale for $pkg_name\"; fi; done",
        postinstall: "npm run copy_fwtoolkit_css && npm run copy_frontend_css && npm run copy_editor_css && npm run copy_bibliography_css && npm run copy_image_manager_css && npm run copy_document_template_editor_css && npm run copy_frontend_static && npm run copy_editor_static && npm run copy_fontawesome && npm run copy_prosemirror_css && npm run copy_mathlive && npm run copy_schema && npm run copy_locale_json && npm run fix_css_urls",
        "babel-transform-template-literals": "babel --plugins @babel/plugin-transform-template-literals"
    },
    author: "Johannes Wilm",
    license: "AGPL",
    private: true,
    dependencies: {
        "@fiduswriter/frontend": "^0.1.44",
        "fwtoolkit": "^0.2.8",
        // Remaining dependencies are listed here to ensure they are hoisted to
        // to the top as static files need to be copied from them (see above)
        "@fiduswriter/editor": "^0.1.76",
        "@fiduswriter/bibliography-manager": "^0.1.29",
        "@fiduswriter/image-manager": "^0.1.22",
        "@fiduswriter/document-template-editor": "^0.1.15",
        "@fiduswriter/document": "^0.2.40",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "source-map-loader": "^5.0.0",
        "regenerator-runtime": "^0.14.1",
        "@aaroon/workbox-rspack-plugin": "^0.3.3",
        "prosemirror-view": "^1.38.1",
        "prosemirror-menu": "^1.2.4",
        "prosemirror-state": "^1.4.3",
        "prosemirror-example-setup": "^1.2.3"
    }
}
